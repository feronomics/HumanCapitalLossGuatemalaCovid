mun_data <- read_excel("mun_data.xlsx", sheet = 1)
### Graphing enrollment v. income
g2<- ggplot(mun_data, aes(y = log(gdppc), x = enrollment)) +
geom_point() + geom_smooth(method = "lm", se = F) + theme_minimal() +
labs(title = "Panel B", y = "log of GDP per capita") +
theme(plot.title = element_text(hjust = 0.5))
### Save graphs
g <- grid.arrange(g1, g2, nrow = 1, ncol = 2)
### Modelling
m1 <- lm(log(labor_income) ~ schooling, treat24_trim)
se1 <- sqrt(diag(vcovHC(m1, type = "HC1")))
m2 <- lm(log(gdppc) ~ enrollment, mun_data)
se2 <- sqrt(diag(vcovHC(m2, type = "HC1")))
##3 Load Data
time_data <- read_excel("mun_data.xlsx", sheet = 2)
time_long <- pivot_longer(time_data, cols = 2:4, names_to = "variable", values_to = "values")
gdp <- ts(time_data$gdp, start = 2001, frequency = 1)
HighSchool <- ts(time_data$HishSchool, start = 2001, frequency = 1)
gdp_d <- diff(log(gdp))
HighSchool_d <- diff(log(HighSchool))
time_data_d <- data.frame(year = seq(from = 2002, to = 2024, by = 1), gdp_d, HighSchool_d)
time_data_d_long <- pivot_longer(time_data_d, cols = 2:3, names_to = "variable", values_to = "values")
time_data_d_long <- time_data_d_long %>% filter(year != 2012, year != 2013)
ggplot(time_data_d_long, aes(x = year, y = values, color = variable, shape = variable)) +
geom_line() + theme_minimal() + geom_point()
### Modelling
m3 <- lm(gdp_d ~ HighSchool_d, time_data_d_long)
summary(m3)
View(time_data_d_long)
View(time_data_d)
### Modelling
m3 <- lm(gdp_d ~ HighSchool_d, time_data_d)
se3 <- sqrt(diag(vcovHC(m3, type = "HC1")))
summary(m3)
### Modelling
m3 <- lm(gdp ~ HighSchool, time_data_d)
se3 <- sqrt(diag(vcovHC(m3, type = "HC1")))
summary(m3)
